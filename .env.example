# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (used from Phase 2)
DATABASE_URL="postgresql://nova:nova@localhost:5432/nova?schema=public"

# Separate database for integration tests. It is emptied on every test run; never point it at real data.
TEST_DATABASE_URL="postgresql://nova:nova@localhost:5432/nova_test?schema=public"

# Authentication secret (used from Phase 3). Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub sign-in (Phase 3). Create an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
# Leave empty to use only the development sign-in, which is disabled in production.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# LLM access (used from Phase 4). The provider is chosen in Phase 1 and sits behind
# the LLMClient interface in packages/ai. "fake" needs no key and is what tests use.
LLM_PROVIDER="fake"
LLM_MODEL=""
LLM_BASE_URL=""
LLM_API_KEY=""
