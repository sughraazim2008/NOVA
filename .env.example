# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (used from Phase 2)
DATABASE_URL="postgresql://nova:nova@localhost:5432/nova?schema=public"

# Separate database for integration tests. It is emptied on every test run; never point it at real data.
TEST_DATABASE_URL="postgresql://nova:nova@localhost:5432/nova_test?schema=public"

# Authentication secret (used from Phase 3). Generate with: openssl rand -base64 32
AUTH_SECRET=""

# GitHub sign-in (Phase 3). Create an OAuth app at https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
# Leave empty to use only the development sign-in, which is disabled in production.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Set to "true" on a private review deployment to keep the one-click demo sign-in in a production
# build. Anyone with the address can then use the demo account, so leave it unset on a public site.
DEMO_SIGNIN=""

# AI model (Phase 4). Leave LLM_PROVIDER empty to run in sample mode: the two example
# sentences work, using plans written in advance, and nothing is sent anywhere.
#
# To connect a real model, set LLM_PROVIDER="openai-compatible" and point it at any service
# that speaks the chat-completions format:
#   a local model:   LLM_BASE_URL="http://localhost:11434/v1"   LLM_MODEL="<model name>"   (no key)
#   a hosted tier:   LLM_BASE_URL="<provider's compatible endpoint>"   LLM_MODEL="<model>"   LLM_API_KEY="<key>"
# Set LLM_JSON_MODE="object" if the provider does not support JSON-schema output.
# Tried and working (Oct 2026): Groq free tier with LLM_BASE_URL="https://api.groq.com/openai/v1",
# LLM_MODEL="openai/gpt-oss-120b", LLM_JSON_MODE="object". Model lists change: if you get HTTP 404,
# the model name is not available to your account.
LLM_PROVIDER=""
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""
LLM_JSON_MODE=""
