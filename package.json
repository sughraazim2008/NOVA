{
  "name": "nova",
  "version": "0.0.0",
  "private": true,
  "description": "NOVA — Adaptive Goal Execution Engine",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @nova/web dev",
    "build": "pnpm --filter @nova/web build",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests && tsc --noEmit -p prisma",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nova/ai": "workspace:*",
    "@nova/behaviour": "workspace:*",
    "@nova/database": "workspace:*",
    "@nova/planner": "workspace:*",
    "@nova/simulation": "workspace:*",
    "@nova/types": "workspace:*",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  }
}
