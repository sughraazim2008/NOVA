{
  "name": "@nova/database",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma client and typed queries. The only package that touches the database.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./generated/enums": "./src/generated/enums.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nova/types": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4"
  }
}
